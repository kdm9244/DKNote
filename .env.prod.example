# Documentation only: Spring Boot does not automatically load this .env file.
# Register the actual values in your hosting service's environment/config vars.
SPRING_PROFILES_ACTIVE=prod
APP_PUBLIC_URL=https://dknote.tech

# Heroku Postgres automatically supplies DATABASE_URL; leave it managed by Heroku.
# Docker translates DATABASE_URL into the JDBC settings with TLS.
# Only for another host without DATABASE_URL, set these three together:
# DB_JDBC_URL=jdbc:postgresql://YOUR_DB_HOST:5432/YOUR_DB_NAME?sslmode=require
# DB_USERNAME=your_app_db_user
# DB_PASSWORD=REPLACE_ON_HOST
JWT_SECRET=REPLACE_WITH_RANDOM_BASE64_KEY_AT_LEAST_32_BYTES
GOOGLE_CLIENT_ID=REPLACE_ON_HOST
GOOGLE_CLIENT_SECRET=REPLACE_ON_HOST

# Preserve local-signup policy; Google automatic signup remains unchanged.
SIGNUP_ENABLED=false
# Optional extra app-side account restriction. Empty keeps the existing policy.
ALLOWED_LOGIN_EMAILS=

# Leave this local while cloud-to-laptop connectivity is not configured.
# A remote endpoint must use HTTPS and a gateway that verifies the bearer token.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_AUTH_TOKEN=
OLLAMA_ALLOWED_MODELS=qwen35-9b-uncensored:latest,qwen3:8b
OLLAMA_MAX_OUTPUT_TOKENS=4096
OLLAMA_CONTEXT_TOKENS=8192
OLLAMA_GENERATION_TIMEOUT_SECONDS=600

# Server-side private R2 storage. Never put these credentials in VITE_* variables.
FILE_STORAGE_PROVIDER=r2
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=dknote-files
R2_ACCESS_KEY_ID=REPLACE_ON_HOST
R2_SECRET_ACCESS_KEY=REPLACE_ON_HOST
